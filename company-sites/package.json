{
  "name": "company-sites",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:global": "SITE_ID=gc astro build --outDir dist/gc",
    "build:volcano": "SITE_ID=vp astro build --outDir dist/volcano",
    "build:all": "npm run build:gc && npm run build:vp",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}